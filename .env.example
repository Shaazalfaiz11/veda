# ---------------------------------------------------------------------------
# Redis — backs both the BullMQ queue and the assessment state store.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Namespace prefix for every key this app writes. Bump it to isolate
# environments that share one Redis instance.
REDIS_KEY_PREFIX=veda

# ---------------------------------------------------------------------------
# Queue / worker
# ---------------------------------------------------------------------------
# How many jobs one worker process handles at once.
WORKER_CONCURRENCY=2

# Attempts per job, including the first. Transient failures back off
# exponentially; permanent validation errors are not retried at all.
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=1000

# How long a completed assessment stays readable via the status endpoint.
ASSESSMENT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Document ingestion
# ---------------------------------------------------------------------------
# Root of the local document store. Relative paths resolve from the project
# root. Never exposed through the API.
STORAGE_ROOT=.storage

# Hard ceiling on an uploaded file, in bytes (10 MB).
MAX_DOCUMENT_BYTES=10485760

# Refuse documents longer than this, to bound preparation cost.
MAX_DOCUMENT_PAGES=50

# Longest edge of a prepared page bitmap, in pixels.
PREPARED_PAGE_MAX_DIMENSION=2000

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Where uploaded PDFs and prepared page bitmaps live: "local" or "r2".
#
# Leave it local for development. A deployment on an ephemeral container must
# set "r2": the disk is replaced on every restart, and the page bitmaps the
# highlight overlay is drawn on would go with it while their metadata survived
# in Redis -- an assessment that reopens to a broken image.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=r2. Create an R2 bucket and an API token with
# Object Read & Write, then take the S3 endpoint from the bucket's settings.
# The endpoint is the account URL, without the bucket name on the end.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Gemini (server/worker only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Required only to run question extraction or the smoke test. Get one from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for every AI call. Centralised: never inline a model name.
GEMINI_MODEL=gemini-3.6-flash

# Per-request timeout, milliseconds.
GEMINI_TIMEOUT_MS=120000

# Upper bound on pages sent in one extraction request.
GEMINI_MAX_PAGES_PER_REQUEST=20

# Ceiling on a single response. Answer extraction returns every answer on
# every page in one body, so a long answer sheet needs a large budget — the
# model default truncates it mid-object and it arrives as unparseable JSON.
GEMINI_MAX_OUTPUT_TOKENS=65536

# ---------------------------------------------------------------------------
# Answer extraction (chunking)
# ---------------------------------------------------------------------------
# A long answer sheet is read as overlapping page chunks rather than in one
# request: past a dozen or so pages the model stops returning the whole reply
# intact. A sheet that fits one chunk still takes a single call.
ANSWER_CHUNK_PAGES=4

# Pages each chunk repeats from the one before. This is what keeps an answer
# that runs onto the next page recognisable as one answer: a span of up to
# ANSWER_CHUNK_OVERLAP + 1 pages is guaranteed to sit wholly inside a chunk.
# Must be smaller than ANSWER_CHUNK_PAGES.
ANSWER_CHUNK_OVERLAP=1

# Pacing between chunk requests. A page image costs ~2,100 tokens and the
# reservation on top of it takes most of an 8,000 TPM minute, so roughly one
# vision request per minute is what the free tier allows. Predicting this
# locally was tried and measured slower; see rate-limiter.ts.
ANSWER_CHUNK_DELAY_MS=55000

# Attempts per chunk before it is recorded as lost. Retrying one chunk is far
# cheaper than the queue retrying the job and re-reading every chunk.
ANSWER_CHUNK_MAX_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Question extraction (chunking)
# ---------------------------------------------------------------------------
# A vision provider caps how many page images one request may carry, so a long
# paper is read in chunks the same way an answer sheet is. On a per-minute
# token budget the binding limit is tokens, not images: one page image costs
# roughly 1,600-1,850 tokens, so a single page per request is what fits an
# 8,000 TPM tier alongside the reply.
QUESTION_CHUNK_PAGES=1
QUESTION_CHUNK_OVERLAP=0

# Same reasoning as ANSWER_CHUNK_DELAY_MS.
QUESTION_CHUNK_DELAY_MS=55000

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Which provider the pipeline uses: "groq" or "gemini". Groq is the default
# for this project because Gemini's free tier allows 20 requests/day/model and
# one real run needs 30-50.
AI_PROVIDER=groq

# Required when AI_PROVIDER is "groq". Get one from https://console.groq.com/keys
GROQ_API_KEY=

# Vision-capable and supports strict JSON schema, which is what makes an
# unparseable reply structurally impossible. Do not change without checking
# both properties hold.
GROQ_MODEL=qwen/qwen3.8-27b

# Per-request timeout, milliseconds.
GROQ_TIMEOUT_MS=180000

# Completion budget per call. Raising this does not buy longer answers so much
# as it eats the per-minute token budget: prompt + this must stay under the
# TPM ceiling or the request is refused outright rather than queued.
GROQ_MAX_OUTPUT_TOKENS=2500

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "local" runs all-MiniLM-L6-v2 in-process: ~90MB downloaded once and cached on
# disk, no API cost, and it keeps the most call-hungry stage off the same quota
# as the stages that genuinely need a large model. "gemini" is the alternative.
EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Mapping and grading pacing
# ---------------------------------------------------------------------------
# Both are text-only calls, one per answer, competing for the same per-minute
# budget as the vision stages — but far cheaper, so they can go much closer
# together. Halved once the reservations below stopped claiming a vision
# chunk's worth of budget for a one-sentence reply.
MAPPING_ADJUDICATION_DELAY_MS=8000
GRADING_CALL_DELAY_MS=6000

# Ceiling the limiter schedules against until the first response reports the
# real one via x-ratelimit-limit-tokens.
GROQ_TPM_BUDGET=8000

# Completion reservations per kind of call. Charged at admission whether used
# or not, so an adjudication that replies in ~80 tokens must not reserve the
# 2,500 a page of questions needs.
GROQ_MAX_OUTPUT_TOKENS_ADJUDICATION=400
GROQ_MAX_OUTPUT_TOKENS_GRADING=1200
