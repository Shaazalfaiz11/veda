{
  "name": "veda-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Assessment Extraction & Answer Mapping — backend and queue foundation",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch workers/assessment.worker.ts",
    "build": "next build",
    "start": "next start",
    "start:worker": "tsx workers/assessment.worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "smoke:gemini": "tsx scripts/gemini-smoke.ts",
    "smoke:answers": "tsx scripts/gemini-answer-smoke.ts",
    "make:answer-sheet": "tsx scripts/make-answer-sheet.ts",
    "smoke:mapping": "tsx scripts/gemini-mapping-smoke.ts",
    "make:question-paper": "tsx scripts/make-question-paper.ts",
    "walkthrough:review": "tsx scripts/review-walkthrough.ts",
    "smoke:grading": "tsx scripts/gemini-grading-smoke.ts",
    "start:all": "node scripts/start-production.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@google/genai": "^2.19.0",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/canvas": "^1.0.8",
    "bullmq": "^5.34.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.2",
    "next": "^15.1.0",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
